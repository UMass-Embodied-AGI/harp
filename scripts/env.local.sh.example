#!/bin/bash
# Copy this file to scripts/env.local.sh and edit for your machine.
#
#   cp scripts/env.local.sh.example scripts/env.local.sh
#   $EDITOR scripts/env.local.sh
#
# scripts/env.local.sh is gitignored — every collaborator can have their own.
# Anything you set here overrides the defaults in scripts/env.sh.
#
# You only need to set the variables that are wrong for your machine.
# Comment out the rest.

# --- Python interpreters ---------------------------------------------------
# The default simulator interpreter is the repo-local
# `.venv-genesis-latest/bin/python`. Set MAWM_PY when this host keeps the pinned
# Genesis 1.2.0 environment elsewhere.
# MAWM_PY=/path/to/your/MAWM/bin/python

# NYX-enabled Genesis interpreter for NYX-rendered VLA batch evaluation
# (scripts/vla_train37/). Defaults to MAWM_PY, which already includes NYX
# when installed from requirements.txt.
# NYX_PY=/path/to/your/MAWM_nyx/bin/python
# LeRobot policy-server python for those jobs when it is not the LEROBOT_PY
# that env.sh derives from VLA_ENV_ROOT.
# T37_LEROBOT_PY=/path/to/your/lerobot/bin/python

# Optional cuRobo interpreter. Embodiments whose asset config selects
# `planner: curobo` (UR5-WSG, ARX-X5) use MplibPlanner when this is unset.
# CUROBO_PY=/path/to/your/curobo/bin/python

# VLA_ENV_ROOT is the parent directory holding the optional per-baseline venvs
# (lerobot/, pi0/). When omitted,
# env.sh recognizes the historical `<root>/MAWM/bin/python` layout; a normal
# repo-local simulator venv uses `<repo>/.venvs` for baseline environments.
# VLA_ENV_ROOT=/path/to/vla-envs

# Individual baseline interpreters override the VLA_ENV_ROOT derivation.
# LEROBOT_PY=/path/to/your/lerobot/bin/python      # smolvla / pi0 / pi05 / lerobot_diffusion
# PI0_PY=/path/to/your/pi0/bin/python              # legacy LeRobot 0.1 (ACT)
# LEROBOT_TRAIN_PY=/path/to/legacy/lerobot/python  # optional override for ACT / LeRobot-Diffusion training

# env.sh selects the GPU backend for the NYX release runtime. Rasterizer-only
# debug jobs can override it explicitly.
# GENESIS_BACKEND=cpu

# --- Optional: SLURM cluster knobs (see docs/cluster.md) -----------------
# Only needed when you submit jobs to a SLURM cluster. Every value is
# cluster-specific; empty or unset means the option is omitted.
#
# scripts/finetune.sh --slurm (FT_GRES is the gres name, usually "gpu"):
# FT_PARTITION=<partition>
# FT_CONSTRAINT="<gpu-constraint>"
# FT_ACCOUNT=
# FT_GRES=gpu
#
# scripts/vla_train37/launch_full.sh and submit.sh. NYX needs Vulkan-capable
# GPUs (not compute-only A100/H100/H200); pi0/pi05 need >=16 GB.
# NYX_GPU_CONSTRAINT="<nyx-gpu-constraint>"
# NYX_LARGE_GPU_CONSTRAINT="<nyx-gpus-with-at-least-16gb>"
# NYX_LARGE_MULTI_GPU_CONSTRAINT="<nyx-gpus-with-about-48gb>"
# NYX_SMALL_GPU_FEATURES="<feature-of-an-11gb-gpu>"
# T37_SBATCH_ARGS="-p <partition> --exclude=<bad-nodes>"
