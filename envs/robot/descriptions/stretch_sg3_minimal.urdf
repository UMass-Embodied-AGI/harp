<?xml version="1.0"?>
<!--
  Lightweight fallback for the Hello Robot Stretch SE3 + SG3 description.

  This model preserves the controlled joint names, limits, origins, axes,
  masses, inertias, and link_grasp_center transform from the full generated
  Stretch URDF.  Primitive visual/collision geometry replaces the separately
  distributed mesh bundle so a release checkout can always construct the
  robot.  When the complete mesh bundle is installed, stretch_robot.py
  deliberately prefers it over this fallback.

  Derived from hello-robot/stretch_urdf (Clear BSD); see stretch.LICENSE.
-->
<robot name="stretch_sg3_minimal">
  <material name="stretch_body"><color rgba="0.79216 0.81961 0.93333 1"/></material>
  <material name="stretch_joint"><color rgba="0.32 0.35 0.42 1"/></material>
  <material name="stretch_tip"><color rgba="0.25 0.25 0.25 1"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.087526 -0.001626 0.081009" rpy="0 0 0"/>
      <mass value="17.384389"/>
      <inertia ixx="0.160002" ixy="0.006758" ixz="0.004621" iyy="0.138068" iyz="0.002208" izz="0.228992"/>
    </inertial>
    <visual>
      <origin xyz="-0.055 0 0.105" rpy="0 0 0"/>
      <geometry><box size="0.42 0.30 0.21"/></geometry>
      <material name="stretch_body"/>
    </visual>
    <collision>
      <origin xyz="-0.055 0 0.105" rpy="0 0 0"/>
      <geometry><box size="0.42 0.30 0.21"/></geometry>
    </collision>
  </link>

  <link name="link_right_wheel">
    <inertial>
      <origin xyz="0 0 0.02765" rpy="0 0 0"/>
      <mass value="0.20773"/>
      <inertia ixx="0.000054" ixy="0" ixz="0" iyy="0.000054" iyz="0" izz="0.000051"/>
    </inertial>
    <visual><geometry><cylinder radius="0.0508" length="0.055"/></geometry><material name="stretch_joint"/></visual>
    <collision><geometry><cylinder radius="0.0508" length="0.055"/></geometry></collision>
  </link>
  <joint name="joint_right_wheel" type="continuous">
    <origin xyz="0 -0.17035 0.0508" rpy="-1.5708 0 0"/>
    <parent link="base_link"/><child link="link_right_wheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="21.75" friction="10.48"/>
  </joint>

  <link name="link_left_wheel">
    <inertial>
      <origin xyz="0 0 -0.02765" rpy="0 0 0"/>
      <mass value="0.20773"/>
      <inertia ixx="0.000054" ixy="0" ixz="0" iyy="0.000054" iyz="0" izz="0.000051"/>
    </inertial>
    <visual><geometry><cylinder radius="0.0508" length="0.055"/></geometry><material name="stretch_joint"/></visual>
    <collision><geometry><cylinder radius="0.0508" length="0.055"/></geometry></collision>
  </link>
  <joint name="joint_left_wheel" type="continuous">
    <origin xyz="0 0.17035 0.0508" rpy="-1.5708 0 0"/>
    <parent link="base_link"/><child link="link_left_wheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="21.75" friction="10.48"/>
  </joint>

  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual><geometry><sphere radius="0.032"/></geometry><material name="stretch_joint"/></visual>
    <collision><geometry><sphere radius="0.032"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <origin xyz="-0.245 0 0.032" rpy="-1.5707963267948966 0 0"/>
    <parent link="base_link"/><child link="caster_link"/>
  </joint>

  <link name="link_mast">
