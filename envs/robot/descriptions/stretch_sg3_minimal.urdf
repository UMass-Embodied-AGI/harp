      <origin xyz="-0.020369 0.03438 0.02236" rpy="0 0 0"/>
      <mass value="1.987167"/>
      <inertia ixx="0.006518" ixy="-0.001539" ixz="0.000371" iyy="0.004464" iyz="0.000392" izz="0.008092"/>
