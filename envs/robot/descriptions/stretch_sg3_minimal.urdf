      <origin xyz="0.000337 0.722201 0.002652" rpy="0 0 0"/>
      <mass value="1.764017"/>
      <inertia ixx="0.291286" ixy="0.004149" ixz="-0.000174" iyy="0.001226" iyz="0.000354" izz="0.291429"/>
    </inertial>
    <visual><origin xyz="0 0.70 0"/><geometry><box size="0.07 1.40 0.07"/></geometry><material name="stretch_body"/></visual>
    <collision><origin xyz="0 0.70 0"/><geometry><box size="0.07 1.40 0.07"/></geometry></collision>
  </link>
  <joint name="joint_mast" type="fixed">
    <origin xyz="-0.067 0.135 0.0284" rpy="1.5708 0 0"/>
